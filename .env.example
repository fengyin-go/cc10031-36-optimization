# 运行环境：local / staging / production
APP_ENV=local

# 指标水位库（SQLite）路径。
# - 留空或不设置：默认使用 backend/var/metric_watermark.sqlite3，持久化处理水位与纳入版本
# - 文件路径：流水线/容器部署时挂载持久卷，例如 /data/metric_watermark.sqlite3
# - :memory:：仅用于本地隔离调试/测试，进程退出后水位不保留
METRICS_DB=

# 前端开发服务器代理后端地址（容器内需用 Compose 服务名）
VITE_PROXY_TARGET=http://127.0.0.1:8000
